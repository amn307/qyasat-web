# Public URL
NEXT_PUBLIC_SITE_URL=https://qyasat.sa

# Firebase Web App (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=qyasatcms.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=qyasatcms
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK service account (server only)
FIREBASE_PROJECT_ID=qyasatcms
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Comma-separated Firebase Authentication emails allowed into /admin
FIREBASE_ADMIN_EMAILS=info@qyasat.sa
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional integrations
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=
